# Resilience Rituals Environment Variables

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Farcaster Integration (Neynar API)
VITE_NEYNAR_API_KEY=your-neynar-api-key

# Stripe Payment Processing
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Privy Wallet Authentication
VITE_PRIVY_APP_ID=your-privy-app-id

# API Configuration
VITE_API_BASE_URL=https://api.resilience-rituals.com

# WalletConnect Project ID (for RainbowKit)
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# App Configuration
VITE_APP_NAME=Resilience Rituals
VITE_APP_DESCRIPTION=Build unbreakable emotional resilience, one ritual at a time
VITE_APP_URL=https://resilience-rituals.com

# Feature Flags
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_FARCASTER_SHARING=true
VITE_ENABLE_PREMIUM_FEATURES=true
VITE_ENABLE_ANALYTICS=true

# Development Settings
VITE_DEBUG_MODE=false
VITE_MOCK_PAYMENTS=false
VITE_MOCK_FARCASTER=false
